# Database development
DATABASE_URL=postgresql://app_user:YOUR_PASSWORD@localhost:5432/venue_booking

# Database test (nama database WAJIB berakhiran _test)
TEST_DATABASE_URL=postgresql://app_user:YOUR_PASSWORD@localhost:5432/venue_booking_test

# Better Auth (buat secret sendiri, minimal 32 karakter)
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_NODE_CRYPTO_RANDOM_BYTES_32_HEX
BETTER_AUTH_URL=http://localhost:3000

# Masa berlaku sesi absolut dalam detik (default 604800 = 7 hari)
AUTH_SESSION_MAX_AGE=604800
